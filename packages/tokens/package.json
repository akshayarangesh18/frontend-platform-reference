{
  "name": "@frontend-platform/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens package for the frontend platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/css/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:tokens": "tsx scripts/build.ts",
    "build": "pnpm run build:tokens && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:drift": "tsx scripts/check-drift.ts",
    "validate": "tsx scripts/validate-tokens.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@frontend-platform/tsconfig": "workspace:*",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
